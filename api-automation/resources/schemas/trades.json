{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/trades/{pair_id}",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tid", "type", "price", "amount", "date"],
    "properties": {
      "tid":    {"type": "string", "pattern": "^[0-9]+$"},
      "type":   {"type": "string", "enum": ["buy", "sell"]},
      "price":  {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?$"},
      "amount": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?$"},
      "date":   {"type": "string", "pattern": "^[0-9]{10}$"}
    }
  }
}
