{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/ticker/{pair_id}",
  "type": "object",
  "required": ["ticker"],
  "properties": {
    "ticker": {
      "type": "object",
      "required": ["buy", "sell", "last", "high", "low", "server_time", "vol_idr"],
      "properties": {
        "buy":  {"$ref": "#/$defs/numericString"},
        "sell": {"$ref": "#/$defs/numericString"},
        "last": {"$ref": "#/$defs/numericString"},
        "high": {"$ref": "#/$defs/numericString"},
        "low":  {"$ref": "#/$defs/numericString"},
        "server_time": {"type": "integer"}
      },
      "patternProperties": {"^vol_[a-z0-9]+$": {"$ref": "#/$defs/numericString"}}
    }
  },
  "$defs": {
    "numericString": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?$"}
  }
}
